# ==============================================================================
# UST Enterprise AI - Environment Configuration Template
# Copy this file to .env and insert your Anthropic API Key
# ==============================================================================
ANTHROPIC_API_KEY=your-anthropic-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Local Open-Source Models (Ollama Fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_FAST_MODEL=llama3.2:1b
OLLAMA_REASONING_MODEL=qwen3.8:27b

# System Configuration
ENABLE_SECURITY_GUARDRAILS=true

